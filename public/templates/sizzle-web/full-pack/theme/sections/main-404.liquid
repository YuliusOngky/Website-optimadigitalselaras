<style type="text/css">
    .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .template-404 .title{font-size: clamp(3rem, 2.4rem + 3vw, 6rem);font-weight: 500;margin: 0;}
  .template-404 .button{margin:20px 0 0;}
  .template-404 .subtext-404{font-size: 14vw;line-height: 1; margin: 0;font-weight: 700; font-family: var(--font-heading-family);}
  .template-404{margin-top:0px;}

 /* .template-404:before{content:'';background:url({{ section.settings.bg_image | image_url: width: 1920 }});background-repeat:no-repeat;background-size:cover;width:100%;height:100%;position:absolute; z-index:-1;}
   */
   .banner-template-wrapper {  height: 100%;  position: relative;} 
  .banner-template-wrapper  .banner__media.media{ height: 100%; position: absolute; left: 0; top: 0; width: 100%; z-index:-1;}
  .template-404 .banner-template-wrapper  .banner__media.media img{ border-radius: var(--media-radius);}
   .template-404 .footer{margin-top:20px;}
       .template-404 .description{ margin: auto;

    margin-top: 2rem;
    margin-bottom: 4rem;
}
 @media screen and (max-width: 1540px) { .template-404 .subtext-404{font-size: 20rem;line-height: 1;}}
 @media screen and (max-width: 990px) { 
   .template-404 .subtext-404{font-size: 20rem;line-height: 1;}
   .template-404 .title{font-size: calc(50px * 0.8);}
    }
 @media screen and (max-width: 749px){
   .template-404 {margin-top: 5.2rem;}
   .template-404 .subtext-404{font-size: 14rem;line-height: 1;}
 }     
  @media screen and (max-width: 749px){
    .template-404 {margin-top: 0rem;} 

   }
 .template-404 .description {opacity:0.85}
@media(min-width:1920px){
    .template-404 .description{max-width:35%}
}

   @media(max-width:1919px){
    .template-404 .description{max-width:50%}
} 
  @media(max-width:1199px){
   .template-404 .description{max-width:60%} 
  }
 
  @media(max-width:1024px){
    .template-404 .subtext-404 svg{width:70rem;height:auto}
  }
 @media(max-width:780px){
    .template-404 .subtext-404 svg {width:50rem;}

    .template-404 .description {max-width:85%;}
  }
  
  @media(max-width:576px){
  .template-404 .description{max-width:95%}
    .template-404 .title{font-size: clamp(2rem, 0.75rem + 6.25vw, 3rem);}
    .template-404 .subtext-404 svg {width:28rem;}
  }
  
  /* .template-404 .subtext-404 svg path{fill-opacity:0.5} */

  
</style>

<div class="template-404 {% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %} center isolate color-{{ section.settings.color_scheme }} gradient">
  <div class="row">
    <div class="banner-template-wrapper section-{{ section.id }}-padding">
      {%- if section.settings.bg_image != blank -%}
    <div class="banner__media media{% if section.settings.bg_image == blank  %} placeholder{% endif %}">
      <img
        srcset="{%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 550 -%}{{ section.settings.bg_image | image_url: width: 550 }} 550w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 750 -%}{{ section.settings.bg_image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 1100 -%}{{ section.settings.bg_image | image_url: width: 1100 }} 1100w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 1500 -%}{{ section.settings.bg_image | image_url: width: 1500 }} 1500w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 1780 -%}{{ section.settings.bg_image | image_url: width: 1780 }} 1780w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 2000 -%}{{ section.settings.bg_image | image_url: width: 2000 }} 2000w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 3000 -%}{{ section.settings.bg_image | image_url: width: 3000 }} 3000w,{%- endif -%}
          {%- if section.settings.bg_image.width >= 3840 -%}{{ section.settings.bg_image | image_url: width: 3840 }} 3840w,{%- endif -%}
          {{ section.settings.bg_image | image_url }} {{ section.settings.bg_image.width }}w"
        sizes="{% if section.settings.bg_image != blank and section.settings.stack_images_on_mobile %}(min-width: 750px) 50vw, 100vw{% elsif section.settings.image_2 != blank %}50vw{% else %}100vw{% endif %}"
        src="{{ section.settings.bg_image | image_url: width: 1500 }}"
        loading="lazy"
        alt="{{ section.settings.bg_image.alt | escape }}"
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.width | divided_by: section.settings.image.aspect_ratio }}"
      >
    </div>
  {%- endif -%}
    <div class="404-wrapper">
  <p class="subtext-404"> {% render '404-svg' %}  </p>
      
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
    <p class="description">
    {{ 'templates.404.description' | t }}
  </p>
  <a href="{{ routes.root_url }}" class="button">
     {{ 'templates.404.button_text' | t }}
  </a>
    </div>    
  </div>   
  </div>
</div>

{% schema %}
{
  "name": "t:sections.template-404-page.name",
  "settings": [
    {
      "type":"checkbox",
      "id":"page_full_width",
       "default": false,
      "label": "t:sections.all.page_full_width.label"
    },
    {
      "type":"checkbox",
      "id":"page_full_width_spacing",
       "default": false,
      "label": "t:sections.all.page_full_width_spacing.label"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:sections.template-404-page.settings.bg_image.label"
    },
      {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ]
}
{% endschema %}