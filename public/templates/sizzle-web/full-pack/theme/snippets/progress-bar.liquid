    position: absolute;
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #ffffff;
    color: rgba(var(--color-button));
    border-radius: 50%;
    border: 1px solid;
    top: 0;
    right: -4px;
    animation: blinkers 1.5s  infinite;
}
  
