# Application Configuration
VITE_APP_NAME=Website OptimaDigitalSelaras
VITE_API_URL=https://api.optimadigitalselaras.com

# Development
# Do not set NODE_ENV in Vite .env files (Vite manages mode itself).
DEBUG=false

# --- Production notes (GIOS + Cloudflare live site) ---
# Live homepage is static Optima HTML (index.html + public/assets/optima).
# Bilingual ID/EN uses browser localStorage key "optima_lang" — no server env required.
# Deploy live origin with: npm run deploy:gios
# Optional Vercel preview uses vercel.json (not www.optimadigitalselaras.com).
# Deploy script env (optional overrides):
#   DEPLOY_HOST=192.168.1.20
#   DEPLOY_USER=NAS GIOS
#   DEPLOY_KEY=%USERPROFILE%\.ssh\id_ed25519
#   DEPLOY_REMOTE_DIR=C:\Users\NASGIO~1\websites\optimadigitalselaras
